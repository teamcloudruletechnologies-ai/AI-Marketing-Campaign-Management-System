# MySQL Database Connection String (optional, SQLite is fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_marketing

# MongoDB URI for Node.js backend
MONGO_URI=mongodb://localhost:27017/ai-marketing

# Google Gemini API Key (for image generation - get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Login credentials for the app gate
LOGIN_EMAIL=admin@brand.com
LOGIN_PASSWORD=admin123
